# Production docker-compose settings. Copy to `.env` (next to
# docker-compose.yml) and fill every value. Never commit the copy.

# Public address. With a domain, Caddy gets HTTPS automatically:
#   SITE_ADDRESS=menu.example.com   PUBLIC_URL=https://menu.example.com
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost
# Host ports published by Caddy (PUBLIC_URL must include a non-default port)
HTTP_PORT=80
HTTPS_PORT=443

# 32+ random characters: openssl rand -base64 32
APP_KEY=

# First super user (created by the seeders: docker compose exec api node ace db:seed)
ADMIN_USER=admin@example.com
ADMIN_PASS=

POSTGRES_USER=menu
POSTGRES_PASSWORD=
POSTGRES_DB=menu
REDIS_PASSWORD=
HEALTH_CHECK_MONITORING_TOKEN=

# E-mail (password reset). Any SMTP provider (Brevo, Resend, SES, Gmail…);
# SMTP_SECURE=true for port 465. Without it, e-mails fail and are retried.
MAIL_FROM_NAME=React Menu
MAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional: web push (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
