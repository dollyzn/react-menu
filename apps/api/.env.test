# Overrides applied on top of .env when NODE_ENV=test (node ace test).
# Never put secrets here: this file is committed.
DB_DATABASE=react-menu-test
LIMITER_STORE=memory
DRIVE_DISK=fs
AUTH_COOKIE_ENABLED=true
# Every test request comes from 127.0.0.1.
PUBLIC_ORDER_RATE_LIMIT=10000
PUBLIC_RATE_LIMIT=10000
# Payments tests use a fake Mercado Pago client, not the dev fake gateway.
PAYMENTS_FAKE_GATEWAY=false
# Own port, so tests run while `pnpm dev` holds 3333 (e2e uses 3334).
PORT=3335
