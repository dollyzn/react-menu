NODE_ENV=development
PORT=3333
APP_KEY=
HOST=localhost
LOG_LEVEL=info
APP_URL=http://localhost:3333
FRONTEND_URL=http://localhost:3000

AUTH_COOKIE_NAME=session-token
AUTH_COOKIE_ENABLED=true

ADMIN_USER=email@teste.com.br
ADMIN_PASS=teste123@

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=jjpasteis-menu

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Web push via Firebase Cloud Messaging (optional, free). From the Firebase
# console: Project settings > Service accounts > Generate new private key.
# Keep the private key on one line with \n escapes, wrapped in quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# fs (local ./storage, served at /uploads), s3 or r2
DRIVE_DISK=fs

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

R2_KEY=
R2_SECRET=
R2_BUCKET=
R2_ENDPOINT=

LIMITER_STORE=redis

# Development only (ignored in production): stores without Mercado Pago
# credentials get a local Pix to try the checkout ("Simular pagamento").
PAYMENTS_FAKE_GATEWAY=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=$APP_URL/api/v1/auth/social/google/callback

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=$APP_URL/api/v1/auth/social/twitter/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=$APP_URL/api/v1/auth/social/facebook/callback

HEALTH_CHECK_MONITORING_TOKEN=some_random_token_value
HEALTH_CHECK_MONITORING_ALLOWLIST=127.0.0.1

HEALTH_DISK_WARN_PCT=75
HEALTH_DISK_FAIL_PCT=85

HEALTH_MEM_HEAP_WARN_MB=300
HEALTH_MEM_HEAP_FAIL_MB=700

HEALTH_MEM_RSS_WARN_MB=600
HEALTH_MEM_RSS_FAIL_MB=800

HEALTH_DB_CONN_WARN=10
HEALTH_DB_CONN_FAIL=15

HEALTH_REDIS_MEM_WARN_MB=100
HEALTH_REDIS_MEM_FAIL_MB=120

# Background jobs (@adonisjs/queue): `pnpm dev` starts the worker too
# (`node ace queue:work` on its own). Keys go under `react-menu:` in Redis.
QUEUE_DRIVER=redis
