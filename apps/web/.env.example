NODE_ENV=development

NEXT_PUBLIC_BUILD_VERSION=1.0

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_API_TIMEOUT=60000

NEXT_PUBLIC_AUTH_COOKIE_NAME=session-token

NEXT_PUBLIC_STORAGE_BASE_NAME=menu-app
NEXT_PUBLIC_PAGE_SIZES=[10, 20, 30, 40, 50]

# Optional web push via Firebase Cloud Messaging (free). Firebase console:
# Project settings > General > Your apps > Web app config (first four), and
# Project settings > Cloud Messaging > Web Push certificates > Key pair.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Server-side only: how the Next server reaches the API when it differs from
# the browser URL (e.g. Docker: http://api:3333/api/v1). Optional.
API_INTERNAL_URL=
