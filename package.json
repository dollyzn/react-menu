{
  "name": "react-menu",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c blue,magenta,green \"pnpm:dev:api\" \"pnpm:dev:worker\" \"pnpm:dev:web\"",
    "dev:worker": "pnpm --filter @react-menu/api run dev:worker",
    "dev:api": "pnpm --filter @react-menu/api run dev",
    "dev:web": "pnpm --filter @react-menu/web run dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:e2e": "pnpm --filter @react-menu/web run test:e2e"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
