# Single origin for web and API: the session cookie is host-only and
# SameSite=Strict, so both must be served from the same host.
# SITE_ADDRESS=:80 serves plain HTTP; a domain (menu.example.com) gets HTTPS
# certificates automatically.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# HTTPS only from the first visit on (ignored over plain HTTP). Add
	# includeSubDomains once every subdomain of the domain is on HTTPS.
	header Strict-Transport-Security "max-age=31536000"
	header -Server

	# /health answers monitors that send X-Monitoring-Secret.
	@api path /api/* /__transmit/* /uploads/* /health
	handle @api {
		# The web sets these for its pages; the API's answers get them here.
		header X-Content-Type-Options nosniff
		header Referrer-Policy strict-origin-when-cross-origin
		# flush_interval -1 keeps Server-Sent Events (Transmit) streaming.
		reverse_proxy api:3333 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
